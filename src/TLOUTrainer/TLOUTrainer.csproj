<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TLOUP1</AssemblyName>
    <Product>TLOUP1</Product>
    <AssemblyTitle>TLOUP1</AssemblyTitle>
    <Description>TLOUP1 — The Last of Us Part I mod paneli</Description>
    <Version>1.0.0</Version>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\game.ico</ApplicationIcon>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Iced" Version="1.21.0" />
    <EmbeddedResource Include="..\..\assets\game.png" LogicalName="TLOUP1.GameIcon" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="TLOUP1.Notices" />
    <EmbeddedResource Include="..\..\.build\RuntimeNotices.txt" LogicalName="TLOUP1.RuntimeNotices"
                      Condition="Exists('..\..\.build\RuntimeNotices.txt')" />
  </ItemGroup>
</Project>
